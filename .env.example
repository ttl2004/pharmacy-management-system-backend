PORT=3000

DB_LOGGING=false

# Đường dẫn tương đối theo prisma/schema.prisma, KHÔNG phải theo thư mục gốc dự án.
DATABASE_URL="file:../data/pos-ndm.sqlite"

# Khóa bí mật để ký JWT: bắt buộc, ít nhất 32 ký tự; hãy tạo giá trị ngẫu nhiên.
JWT_ACCESS_SECRET=
# Số nguyên dương kèm đơn vị s (giây), m (phút), h (giờ) hoặc d (ngày).
JWT_ACCESS_TTL=15m
# Thời hạn RT cố định từ lúc đăng nhập; refresh không gia hạn, hết hạn phải đăng nhập lại.
REFRESH_TTL=7d
# Chỉ bật khi cần kiểm thử refresh token qua body bằng Swagger/Postman.
# Môi trường production + true sẽ ghi cảnh báo mức cao, không thay đổi hành vi.
AUTH_REFRESH_IN_BODY=false
# Đặt true khi dùng HTTPS. SameSite=none bắt buộc giá trị true.
COOKIE_SECURE=false
# Nhận strict (mặc định), lax hoặc none.
COOKIE_SAMESITE=strict
# Hiện chưa có tiền tố toàn cục; nếu thêm /api, đổi giá trị này thành /api/auth.
COOKIE_PATH=/auth

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Super Admin
SUPER_ADMIN_PHONE_NUMBER=
SUPER_ADMIN_ADDRESS=
SUPER_ADMIN_AGE=
SUPER_ADMIN_GENDER=male
