generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ba điểm lệch thiết kế có chủ đích so với docs/thiet-ke-csdl-dbml.md:
// 1. Khoá chính dùng `@default(uuid())` — Prisma sinh ở client, không phải DEFAULT gen_random_uuid()
//    phía DB. Hệ quả: INSERT thô bằng SQL phải tự cấp `id`.
// 2. `createdBy`/`updatedBy` là uuid nên KHÔNG được ghi chuỗi tự do; tác nhân hệ thống dùng
//    hằng SYSTEM_ACTOR_ID trong src/common/constants/app.constant.ts.
// 3. `products.imageUrls` dùng `String[] @default([])` thay vì `text[] NULL` như từ điển, để client
//    không phải xử lý null và invariant "luôn là mảng" kiểm được ở tầng DTO.

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  CREAM
  OINTMENT
  DROPS
  INJECTION
  SUPPOSITORY
  POWDER
  EFFERVESCENT
  SPRAY
  OTHER
}

/// Loại hàng như KiotViet: thuốc (có số đăng ký, thường quản lý theo lô) hay hàng hoá thường.
enum ProductType {
  DRUG
  GOODS
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  isDeleted    Boolean      @default(false)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  createdBy    String?      @db.Uuid
  updatedAt    DateTime?    @db.Timestamptz(3)
  updatedBy    String?      @db.Uuid
  code         String       @unique @db.VarChar(20)
  name         String       @db.VarChar(200)
  phone        String       @db.VarChar(20)
  email        String?      @db.VarChar(150)
  address      String       @db.Text
  openingHours String?      @db.VarChar(100)
  status       RecordStatus @default(ACTIVE)

  users User[]

  goodsReceipts           GoodsReceipt[]
  stockBatches            StockBatch[]
  stockMovements          StockMovement[]
  transfersOut            StockTransfer[]          @relation("TransferFromBranch")
  transfersIn             StockTransfer[]          @relation("TransferToBranch")
  stockAdjustments        StockAdjustment[]
  branchProducts          BranchProduct[]
  auditLogs               AuditLog[]
  orders                  Order[]
  priceBookBranches       PriceBookBranch[]
  supplierPayments        SupplierPayment[]
  supplierDebtAdjustments SupplierDebtAdjustment[]

  @@map("branches")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  createdBy   String?    @db.Uuid
  updatedAt   DateTime?  @db.Timestamptz(3)
  updatedBy   String?    @db.Uuid
  phoneNumber String?    @unique @db.VarChar(15)
  email       String?    @unique @db.VarChar(150)
  address     String?    @db.Text
  fullName    String     @db.VarChar(150)
  dateOfBirth DateTime?  @db.Date
  gender      Gender?
  status      UserStatus @default(ACTIVE)
  roleId      String     @db.Uuid
  branchId    String?    @db.Uuid

  role          Role           @relation(fields: [roleId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  auth          Auth?
  refreshTokens RefreshToken[]

  // Quan hệ ngược của các cột người thao tác nhóm kho — chỉ để Prisma tạo FK, không dùng để truy vấn.
  suppliersCreated            Supplier[]            @relation("SupplierCreatedBy")
  suppliersUpdated            Supplier[]            @relation("SupplierUpdatedBy")
  goodsReceiptsCreated        GoodsReceipt[]        @relation("GoodsReceiptCreatedBy")
  goodsReceiptsUpdated        GoodsReceipt[]        @relation("GoodsReceiptUpdatedBy")
  goodsReceiptsConfirmed      GoodsReceipt[]        @relation("GoodsReceiptConfirmedBy")
  goodsReceiptsCancelled      GoodsReceipt[]        @relation("GoodsReceiptCancelledBy")
  goodsReceiptItemsCreated    GoodsReceiptItem[]    @relation("GoodsReceiptItemCreatedBy")
  goodsReceiptItemsUpdated    GoodsReceiptItem[]    @relation("GoodsReceiptItemUpdatedBy")
  stockBatchesCreated         StockBatch[]          @relation("StockBatchCreatedBy")
  stockBatchesUpdated         StockBatch[]          @relation("StockBatchUpdatedBy")
  stockBatchesBlocked         StockBatch[]          @relation("StockBatchBlockedBy")
  stockMovementsCreated       StockMovement[]       @relation("StockMovementCreatedBy")
  stockTransfersCreated       StockTransfer[]       @relation("StockTransferCreatedBy")
  stockTransfersUpdated       StockTransfer[]       @relation("StockTransferUpdatedBy")
  stockTransfersShipped       StockTransfer[]       @relation("StockTransferShippedBy")
  stockTransfersReceived      StockTransfer[]       @relation("StockTransferReceivedBy")
  stockTransfersCancelled     StockTransfer[]       @relation("StockTransferCancelledBy")
  stockTransferItemsCreated   StockTransferItem[]   @relation("StockTransferItemCreatedBy")
  stockTransferItemsUpdated   StockTransferItem[]   @relation("StockTransferItemUpdatedBy")
  stockAdjustmentsCreated     StockAdjustment[]     @relation("StockAdjustmentCreatedBy")
  stockAdjustmentsUpdated     StockAdjustment[]     @relation("StockAdjustmentUpdatedBy")
  stockAdjustmentsConfirmed   StockAdjustment[]     @relation("StockAdjustmentConfirmedBy")
  stockAdjustmentsHandled     StockAdjustment[]     @relation("StockAdjustmentHandler")
  stockAdjustmentsReceived    StockAdjustment[]     @relation("StockAdjustmentReceiver")
  stockAdjustmentsCancelled   StockAdjustment[]     @relation("StockAdjustmentCancelledBy")
  stockAdjustmentItemsCreated StockAdjustmentItem[] @relation("StockAdjustmentItemCreatedBy")
  stockAdjustmentItemsUpdated StockAdjustmentItem[] @relation("StockAdjustmentItemUpdatedBy")
  branchProductsCreated       BranchProduct[]       @relation("BranchProductCreatedBy")
  branchProductsUpdated       BranchProduct[]       @relation("BranchProductUpdatedBy")
  auditLogs                   AuditLog[]            @relation("AuditLogActor")

  // Quan hệ ngược của NCC bổ sung đợt 4 — chỉ để Prisma tạo FK.
  goodsReceiptsReceived            GoodsReceipt[]           @relation("GoodsReceiptReceiver")
  supplierGroupsCreated            SupplierGroup[]          @relation("SupplierGroupCreatedBy")
  supplierGroupsUpdated            SupplierGroup[]          @relation("SupplierGroupUpdatedBy")
  supplierPaymentsCreated          SupplierPayment[]        @relation("SupplierPaymentCreatedBy")
  supplierPaymentsUpdated          SupplierPayment[]        @relation("SupplierPaymentUpdatedBy")
  supplierPaymentsCancelled        SupplierPayment[]        @relation("SupplierPaymentCancelledBy")
  supplierDebtAdjustmentsCreated   SupplierDebtAdjustment[] @relation("SupplierDebtAdjustmentCreatedBy")
  supplierDebtAdjustmentsUpdated   SupplierDebtAdjustment[] @relation("SupplierDebtAdjustmentUpdatedBy")
  supplierDebtAdjustmentsCancelled SupplierDebtAdjustment[] @relation("SupplierDebtAdjustmentCancelledBy")

  // Quan hệ ngược của nhóm bán hàng — chỉ để Prisma tạo FK.
  ordersAsCustomer  Order[]     @relation("OrderCustomer")
  ordersAsStaff     Order[]     @relation("OrderStaff")
  ordersCreated     Order[]     @relation("OrderCreatedBy")
  ordersUpdated     Order[]     @relation("OrderUpdatedBy")
  orderItemsCreated OrderItem[] @relation("OrderItemCreatedBy")
  orderItemsUpdated OrderItem[] @relation("OrderItemUpdatedBy")
  paymentsCreated   Payment[]   @relation("PaymentCreatedBy")

  // Người bán được giới hạn của bảng giá.
  priceBookUsers PriceBookUser[]

  @@map("users")
}

model Auth {
  id                    String    @id @default(uuid()) @db.Uuid
  isDeleted             Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  createdBy             String?   @db.Uuid
  updatedAt             DateTime? @db.Timestamptz(3)
  updatedBy             String?   @db.Uuid
  password              String    @db.VarChar(100)
  username              String    @unique @db.VarChar(50)
  lastChangedPasswordAt DateTime? @db.Timestamptz(3)
  userId                String    @unique @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("auths")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sid          String    @db.VarChar(50)
  tokenHash    String    @unique @db.VarChar(100)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.VarChar(100)
  userAgent    String?   @db.VarChar(300)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sid])
  @@index([sid])
  @@map("refresh_tokens")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedAt   DateTime? @db.Timestamptz(3)
  updatedBy   String?   @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(300)
  level       Int
  isSystem    Boolean   @default(true)

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  code      String    @unique @db.VarChar(100)
  name      String    @db.VarChar(200)
  module    String    @db.VarChar(50)
  sortOrder Int       @default(0)

  rolePermissions RolePermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  createdBy    String?   @db.Uuid
  updatedAt    DateTime? @db.Timestamptz(3)
  updatedBy    String?   @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  createdBy String?      @db.Uuid
  updatedAt DateTime?    @db.Timestamptz(3)
  updatedBy String?      @db.Uuid
  code      String?      @unique @db.VarChar(30)
  name      String       @db.VarChar(200)
  parentId  String?      @db.Uuid
  sortOrder Int          @default(0)
  status    RecordStatus @default(ACTIVE)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([status, sortOrder])
  @@map("categories")
}

model Manufacturer {
  id        String       @id @default(uuid()) @db.Uuid
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  createdBy String?      @db.Uuid
  updatedAt DateTime?    @db.Timestamptz(3)
  updatedBy String?      @db.Uuid
  code      String?      @unique @db.VarChar(30)
  name      String       @db.VarChar(200)
  country   String?      @db.VarChar(100)
  address   String?      @db.Text
  note      String?      @db.Text
  status    RecordStatus @default(ACTIVE)

  products Product[]

  @@index([status])
  @@map("manufacturers")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  note      String?   @db.Text

  baseProducts Product[]     @relation("BaseUnit")
  productUnits ProductUnit[]

  @@map("units")
}

model Product {
  id                   String       @id @default(uuid()) @db.Uuid
  isDeleted            Boolean      @default(false)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  createdBy            String?      @db.Uuid
  updatedAt            DateTime?    @db.Timestamptz(3)
  updatedBy            String?      @db.Uuid
  code                 String       @unique @db.VarChar(30)
  barcode              String?      @unique @db.VarChar(50)
  name                 String       @db.VarChar(250)
  imageUrls            String[]     @default([])
  categoryId           String       @db.Uuid
  manufacturerId       String?      @db.Uuid
  baseUnitId           String       @db.Uuid
  activeIngredient     String?      @db.VarChar(250)
  strength             String?      @db.VarChar(100)
  dosageForm           DosageForm?
  packagingSpec        String?      @db.VarChar(150)
  requiresPrescription Boolean      @default(false)
  indications          String?      @db.Text
  dosageNote           String?      @db.Text
  storageNote          String?      @db.Text
  minStockLevel        Int          @default(0)
  status               RecordStatus @default(ACTIVE)
  /// Không đổi được sau khi tạo.
  type                 ProductType  @default(DRUG)
  /// Quản lý theo lô, hạn sử dụng. Không đổi được khi sản phẩm đã phát sinh kho.
  trackBatches         Boolean      @default(true)
  /// Thuốc kiểm soát đặc biệt (gây nghiện, hướng thần…).
  isControlled         Boolean      @default(false)
  registrationNumber   String?      @db.VarChar(50)
  countryOfOrigin      String?      @db.VarChar(100)
  /// Định mức tồn tối đa; null = không giới hạn.
  maxStockLevel        Int?
  shortName            String?      @db.VarChar(100)
  /// Trọng lượng theo `weightUnit` (g | kg).
  weight               Decimal?     @db.Decimal(12, 3)
  weightUnit           String       @default("g") @db.VarChar(5)
  description          String?      @db.Text
  orderNote            String?      @db.Text
  /// Đánh dấu sao ở danh sách hàng hóa (dùng chung toàn chuỗi).
  isFavourite          Boolean      @default(false)
  /// Mã thuốc CSDL Dược quốc gia (danh mục DQG chưa có ở BE — lưu chuỗi).
  nationalDrugCode     String?      @db.VarChar(50)
  routeId              String?      @db.Uuid

  category     Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer?            @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  baseUnit     Unit                     @relation("BaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  route        AdministrationRoute?     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  units        ProductUnit[]
  locations    ProductLocation[]

  goodsReceiptItems    GoodsReceiptItem[]
  stockBatches         StockBatch[]
  stockMovements       StockMovement[]
  stockTransferItems   StockTransferItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  branchProducts       BranchProduct[]
  orderItems           OrderItem[]

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([baseUnitId])
  @@index([status])
  @@index([requiresPrescription])
  @@index([type])
  @@map("products")
}

/// Vị trí (kệ/tủ) dùng chung toàn chuỗi. Một sản phẩm có thể nằm ở nhiều vị trí.
model ShelfLocation {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  name      String    @unique @db.VarChar(100)

  products ProductLocation[]

  @@map("shelf_locations")
}

/// Đường dùng của thuốc (uống, tiêm bắp…) — danh mục chung, tạo thêm ngay trong form sản phẩm.
model AdministrationRoute {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  name      String    @unique @db.VarChar(100)

  products Product[]

  @@map("administration_routes")
}

/// Bảng nối sản phẩm ↔ vị trí. Sửa sản phẩm gửi `locationIds` là thay toàn bộ (xoá dòng cũ, ghi dòng mới).
model ProductLocation {
  productId  String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  location ShelfLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@index([locationId])
  @@map("product_locations")
}

model ProductUnit {
  id             String       @id @default(uuid()) @db.Uuid
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  createdBy      String?      @db.Uuid
  updatedAt      DateTime?    @db.Timestamptz(3)
  updatedBy      String?      @db.Uuid
  productId      String       @db.Uuid
  unitId         String       @db.Uuid
  conversionRate Int
  salePrice      Int
  barcode        String?      @unique @db.VarChar(50)
  isBaseUnit     Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  /// Cho bán lẻ đơn vị này ở POS (tắt = chỉ dùng để nhập/quy đổi).
  allowLooseSale   Boolean      @default(true)
  /// Mã đơn vị tính CSDL Dược quốc gia — chỉ ghi qua màn ghép mã, không qua form sản phẩm.
  nationalUnitCode String?      @db.VarChar(50)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  goodsReceiptItems GoodsReceiptItem[]
  orderItems        OrderItem[]
  priceBookItems    PriceBookItem[]

  @@unique([productId, unitId])
  @@index([productId, isDeleted])
  @@index([unitId])
  @@index([status])
  @@map("product_units")
}

// ============================================================
//  NHÓM KHO + NHẬT KÝ THAO TÁC — thiết kế: docs/thiet-ke-csdl-dbml.md (31 bảng)
//  - Mọi số lượng theo ĐƠN VỊ CƠ BẢN; đơn giá Int (đồng); mọi cột TỔNG TIỀN phiếu nhập là BigInt (K2).
//  - Mọi cột người thao tác (createdBy, updatedBy, …By) là FK → users (quy ước nhóm kho).
//  - CHECK và SEQUENCE nằm trong SQL thô của migration — Prisma không khai được nhưng cũng không xoá chúng.
//  - KHÔNG dùng partial index: Prisma không biểu diễn được và migration sau sẽ tự sinh lệnh DROP INDEX.
// ============================================================

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum ReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AdjustmentType {
  STOCK_TAKE
  DISPOSE
  RETURN_TO_SUPPLIER
  OTHER
}

enum BatchStatus {
  AVAILABLE
  QUARANTINE
  RECALLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  IMPORT
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  DISPOSE
  RETURN_IN
  RETURN_OUT
}

enum StockRefType {
  GOODS_RECEIPT
  ORDER
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  /// Tồn đầu lúc tạo hàng không theo lô; refId = id sản phẩm.
  OPENING_STOCK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

model Supplier {
  id          String       @id @default(uuid()) @db.Uuid
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  createdBy   String?      @db.Uuid
  updatedAt   DateTime?    @db.Timestamptz(3)
  updatedBy   String?      @db.Uuid
  code        String       @unique @db.VarChar(30)
  name        String       @db.VarChar(200)
  phone       String       @db.VarChar(20)
  email       String?      @db.VarChar(150)
  address     String?      @db.Text
  taxCode     String?      @db.VarChar(20)
  contactName String?      @db.VarChar(150)
  note        String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  /// Nhóm NCC (nullable — NCC cũ chưa phân nhóm).
  groupId     String?      @db.Uuid
  companyName String?      @db.VarChar(200)
  /// CMND/CCCD của NCC cá nhân.
  idNumber    String?      @db.VarChar(20)

  group         SupplierGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdByUser User?          @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?          @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  goodsReceipts    GoodsReceipt[]
  stockBatches     StockBatch[]
  stockAdjustments StockAdjustment[]
  payments         SupplierPayment[]
  debtAdjustments  SupplierDebtAdjustment[]

  @@index([status])
  @@index([groupId])
  @@map("suppliers")
}

model GoodsReceipt {
  id                    String         @id @default(uuid()) @db.Uuid
  isDeleted             Boolean        @default(false)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  createdBy             String?        @db.Uuid
  updatedAt             DateTime?      @db.Timestamptz(3)
  updatedBy             String?        @db.Uuid
  code                  String         @unique @db.VarChar(20)
  branchId              String         @db.Uuid
  supplierId            String         @db.Uuid
  status                ReceiptStatus  @default(DRAFT)
  receivedAt            DateTime?      @db.Timestamptz(3)
  subtotalAmount        BigInt         @default(0)
  discountAmount        BigInt         @default(0)
  vatAmount             BigInt         @default(0)
  totalAmount           BigInt         @default(0)
  paidAmount            BigInt         @default(0)
  paymentStatus         PaymentStatus  @default(UNPAID)
  supplierInvoiceNo     String?        @db.VarChar(50)
  supplierInvoiceDate   DateTime?      @db.Date
  confirmedAt           DateTime?      @db.Timestamptz(3)
  confirmedBy           String?        @db.Uuid
  cancelledAt           DateTime?      @db.Timestamptz(3)
  cancelledBy           String?        @db.Uuid
  cancelReason          String?        @db.Text
  note                  String?        @db.Text
  /// Người nhập hàng (có thể khác người tạo phiếu).
  receiverId            String?        @db.Uuid
  /// Hình thức trả NCC lúc xác nhận: CASH | BANK_TRANSFER (CHECK cấm COD).
  paymentMethod         PaymentMethod?
  /// Chiết khấu % (null = giảm giá theo VND ở discountAmount).
  discountPercent       Decimal?       @db.Decimal(5, 2)
  /// Chi phí nhập cộng vào "Cần trả NCC".
  supplierExpenseAmount BigInt         @default(0)
  /// Chi phí nhập chỉ tính vào giá vốn, không cộng vào công nợ NCC.
  otherExpenseAmount    BigInt         @default(0)
  /// Bản chụp chi phí: [{code,name,kind,valueType,value,amount}].
  expenses              Json?          @db.JsonB

  receiver           User?                       @relation("GoodsReceiptReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  paymentAllocations SupplierPaymentAllocation[]
  branch             Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser      User?                       @relation("GoodsReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser      User?                       @relation("GoodsReceiptUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  confirmedByUser    User?                       @relation("GoodsReceiptConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  cancelledByUser    User?                       @relation("GoodsReceiptCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items              GoodsReceiptItem[]
  purchaseReturns    StockAdjustment[]

  @@index([branchId, status, createdAt])
  @@index([supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                String    @id @default(uuid()) @db.Uuid
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  createdBy         String?   @db.Uuid
  updatedAt         DateTime? @db.Timestamptz(3)
  updatedBy         String?   @db.Uuid
  receiptId         String    @db.Uuid
  productId         String    @db.Uuid
  productUnitId     String    @db.Uuid
  quantity          Int
  conversionRate    Int
  baseQuantity      Int
  importPrice       Int
  totalPrice        BigInt
  batchNumber       String    @db.VarChar(50)
  manufacturingDate DateTime? @db.Date
  expiryDate        DateTime  @db.Date
  /// Giảm giá trên MỖI đơn vị nhập (VND).
  unitDiscount      Int       @default(0)
  note              String?   @db.Text

  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit   ProductUnit  @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  createdByUser User?        @relation("GoodsReceiptItemCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?        @relation("GoodsReceiptItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  batches       StockBatch[]
  returnItems   StockAdjustmentItem[]

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

/// RECEIPT = phiếu chi tự sinh khi xác nhận phiếu nhập có "Tiền trả NCC"; MANUAL = lập tay.
enum SupplierPaymentSource {
  MANUAL
  RECEIPT
}

/// Nhóm NCC. Xoá mềm như các danh mục khác.
model SupplierGroup {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  name      String    @db.VarChar(100)
  note      String?   @db.Text

  createdByUser User?      @relation("SupplierGroupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?      @relation("SupplierGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  suppliers     Supplier[]

  @@map("supplier_groups")
}

/// Phiếu chi trả NCC (TTPN…). Chứng từ tài chính: không xoá mềm, huỷ = cancelledAt.
/// amount = Σ allocations; GoodsReceipt.paidAmount là bộ đệm của Σ phân bổ chưa huỷ.
model SupplierPayment {
  id           String                @id @default(uuid()) @db.Uuid
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  createdBy    String?               @db.Uuid
  updatedAt    DateTime?             @db.Timestamptz(3)
  updatedBy    String?               @db.Uuid
  code         String                @unique @db.VarChar(20)
  supplierId   String                @db.Uuid
  branchId     String                @db.Uuid
  paidAt       DateTime              @db.Timestamptz(3)
  method       PaymentMethod
  amount       BigInt
  note         String?               @db.Text
  source       SupplierPaymentSource @default(MANUAL)
  cancelledAt  DateTime?             @db.Timestamptz(3)
  cancelledBy  String?               @db.Uuid
  cancelReason String?               @db.Text

  supplier        Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch          Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByUser   User?                       @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User?                       @relation("SupplierPaymentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  cancelledByUser User?                       @relation("SupplierPaymentCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  allocations     SupplierPaymentAllocation[]

  @@index([supplierId, paidAt])
  @@index([branchId])
  @@map("supplier_payments")
}

/// Phân bổ một phiếu chi vào từng phiếu nhập.
model SupplierPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  paymentId String   @db.Uuid
  receiptId String   @db.Uuid
  amount    BigInt

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receipt GoodsReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@unique([paymentId, receiptId])
  @@index([receiptId])
  @@map("supplier_payment_allocations")
}

/// Điều chỉnh công nợ NCC (DCN…), cấp chuỗi. Huỷ = cancelledAt.
model SupplierDebtAdjustment {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  createdBy    String?   @db.Uuid
  updatedAt    DateTime? @db.Timestamptz(3)
  updatedBy    String?   @db.Uuid
  code         String    @unique @db.VarChar(20)
  supplierId   String    @db.Uuid
  branchId     String    @db.Uuid
  adjustedAt   DateTime  @db.Timestamptz(3)
  debtBefore   BigInt
  debtAfter    BigInt
  delta        BigInt
  note         String    @db.Text
  cancelledAt  DateTime? @db.Timestamptz(3)
  cancelledBy  String?   @db.Uuid
  cancelReason String?   @db.Text

  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByUser   User?    @relation("SupplierDebtAdjustmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User?    @relation("SupplierDebtAdjustmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  cancelledByUser User?    @relation("SupplierDebtAdjustmentCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
  @@index([branchId])
  @@map("supplier_debt_adjustments")
}

model StockBatch {
  id                 String      @id @default(uuid()) @db.Uuid
  isDeleted          Boolean     @default(false)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  createdBy          String?     @db.Uuid
  updatedAt          DateTime?   @db.Timestamptz(3)
  updatedBy          String?     @db.Uuid
  branchId           String      @db.Uuid
  productId          String      @db.Uuid
  batchNumber        String      @db.VarChar(50)
  manufacturingDate  DateTime?   @db.Date
  expiryDate         DateTime    @db.Date
  quantityOnHand     Int         @default(0)
  reservedQuantity   Int         @default(0)
  importPrice        Int
  supplierId         String?     @db.Uuid
  goodsReceiptItemId String?     @db.Uuid
  status             BatchStatus @default(AVAILABLE)
  blockedReason      String?     @db.Text
  blockedAt          DateTime?   @db.Timestamptz(3)
  blockedBy          String?     @db.Uuid

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  createdByUser    User?             @relation("StockBatchCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser    User?             @relation("StockBatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  blockedByUser    User?             @relation("StockBatchBlockedBy", fields: [blockedBy], references: [id], onDelete: Restrict)

  movements        StockMovement[]
  transferItemsOut StockTransferItem[]   @relation("TransferFromBatch")
  transferItemsIn  StockTransferItem[]   @relation("TransferToBatch")
  adjustmentItems  StockAdjustmentItem[]
  orderItemBatches OrderItemBatch[]

  @@unique([branchId, productId, batchNumber])
  @@index([branchId, productId, expiryDate])
  @@index([expiryDate])
  @@index([productId, batchNumber])
  @@map("stock_batches")
}

/// Sổ kho — BẤT BIẾN: không isDeleted, không updatedAt. Chỉ StockLedgerService được ghi.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  createdBy    String?           @db.Uuid
  branchId     String            @db.Uuid
  productId    String            @db.Uuid
  batchId      String            @db.Uuid
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  unitCost     Int?
  refType      StockRefType
  refId        String            @db.Uuid
  refItemId    String?           @db.Uuid
  note         String?           @db.Text

  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdByUser User?      @relation("StockMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([branchId, productId, createdAt])
  @@index([branchId, createdAt, id])
  @@index([refType, refId])
  @@index([batchId, createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id           String         @id @default(uuid()) @db.Uuid
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  createdBy    String?        @db.Uuid
  updatedAt    DateTime?      @db.Timestamptz(3)
  updatedBy    String?        @db.Uuid
  code         String         @unique @db.VarChar(20)
  fromBranchId String         @db.Uuid
  toBranchId   String         @db.Uuid
  status       TransferStatus @default(PENDING)
  shippedAt    DateTime?      @db.Timestamptz(3)
  shippedBy    String?        @db.Uuid
  receivedAt   DateTime?      @db.Timestamptz(3)
  receivedBy   String?        @db.Uuid
  cancelledAt  DateTime?      @db.Timestamptz(3)
  cancelledBy  String?        @db.Uuid
  cancelReason String?        @db.Text
  note         String?        @db.Text

  fromBranch      Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch        Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  createdByUser   User?               @relation("StockTransferCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User?               @relation("StockTransferUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  shippedByUser   User?               @relation("StockTransferShippedBy", fields: [shippedBy], references: [id], onDelete: Restrict)
  receivedByUser  User?               @relation("StockTransferReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
  cancelledByUser User?               @relation("StockTransferCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items           StockTransferItem[]

  @@index([fromBranchId, status, createdAt])
  @@index([toBranchId, status, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String    @id @default(uuid()) @db.Uuid
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  createdBy  String?   @db.Uuid
  updatedAt  DateTime? @db.Timestamptz(3)
  updatedBy  String?   @db.Uuid
  transferId String    @db.Uuid
  productId  String    @db.Uuid
  batchId    String    @db.Uuid
  toBatchId  String?   @db.Uuid
  quantity   Int
  note       String?   @db.Text
  /// Số thực nhận (null = chưa nhận, hoặc phiếu nhận đủ trước khi có cột này).
  receivedQuantity Int?
  /// Bắt buộc khi nhận thiếu.
  varianceReason   String? @db.Text

  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         StockBatch    @relation("TransferFromBatch", fields: [batchId], references: [id], onDelete: Restrict)
  toBatch       StockBatch?   @relation("TransferToBatch", fields: [toBatchId], references: [id], onDelete: Restrict)
  createdByUser User?         @relation("StockTransferItemCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?         @relation("StockTransferItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([transferId, batchId])
  @@index([batchId])
  @@map("stock_transfer_items")
}

model StockAdjustment {
  id           String         @id @default(uuid()) @db.Uuid
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  createdBy    String?        @db.Uuid
  updatedAt    DateTime?      @db.Timestamptz(3)
  updatedBy    String?        @db.Uuid
  /// Sinh tự động (KK/XH/TH/XD…) hoặc người dùng nhập; tối đa 40 như FE.
  code         String         @unique @db.VarChar(40)
  branchId     String         @db.Uuid
  type         AdjustmentType
  status       ReceiptStatus  @default(DRAFT)
  supplierId   String?        @db.Uuid
  reason       String         @db.Text
  confirmedAt  DateTime?      @db.Timestamptz(3)
  confirmedBy  String?        @db.Uuid
  cancelledAt  DateTime?      @db.Timestamptz(3)
  cancelledBy  String?        @db.Uuid
  cancelReason String?        @db.Text
  note         String?        @db.Text
  /// Ngày chứng từ (ngày kiểm/huỷ/trả/xuất) do người dùng chọn; mặc định lúc lập.
  documentDate      DateTime  @default(now()) @db.Timestamptz(3)
  /// Người xuất huỷ / người trả / người xuất dùng.
  handlerId         String?   @db.Uuid
  /// Người nhận (xuất dùng nội bộ).
  receiverId        String?   @db.Uuid
  internalUseTypeId String?   @db.Uuid
  isFavourite       Boolean   @default(false)
  // --- Tiền phiếu trả NCC (chỉ RETURN_TO_SUPPLIER; loại khác để 0/null) ---
  /// Trả theo phiếu nhập gốc (tuỳ chọn): cùng chi nhánh + NCC, phiếu đã xác nhận.
  goodsReceiptId      String?        @db.Uuid
  /// Σ SL × giá trả lại.
  goodsAmount         BigInt         @default(0)
  discountAmount      BigInt         @default(0)
  /// Giảm giá % (null = theo VND ở discountAmount).
  discountPercent     Decimal?       @db.Decimal(5, 2)
  refundExpenseAmount BigInt         @default(0)
  /// Bản chụp chi phí nhập hoàn lại: [{code,name,receivedAmount,amount}] — chỉ khi trả theo phiếu nhập.
  refundExpenses      Json?          @db.JsonB
  /// NCC cần trả = goodsAmount − discountAmount + refundExpenseAmount.
  totalAmount         BigInt         @default(0)
  /// Tiền NCC hoàn ngay; phần còn lại (totalAmount − supplierPaid) giảm công nợ NCC khi phiếu CONFIRMED.
  supplierPaid        BigInt         @default(0)
  paymentMethod       PaymentMethod?

  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  goodsReceipt    GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  handler         User?                 @relation("StockAdjustmentHandler", fields: [handlerId], references: [id], onDelete: Restrict)
  receiver        User?                 @relation("StockAdjustmentReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  internalUseType InternalUseType?      @relation(fields: [internalUseTypeId], references: [id], onDelete: Restrict)
  createdByUser   User?                 @relation("StockAdjustmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User?                 @relation("StockAdjustmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  confirmedByUser User?                 @relation("StockAdjustmentConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  cancelledByUser User?                 @relation("StockAdjustmentCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items           StockAdjustmentItem[]

  @@index([branchId, status, createdAt])
  @@map("stock_adjustments")
}

/// Loại xuất dùng nội bộ (văn phòng phẩm, vệ sinh…) — danh mục chung toàn chuỗi.
model InternalUseType {
  id        String    @id @default(uuid()) @db.Uuid
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime? @db.Timestamptz(3)
  updatedBy String?   @db.Uuid
  name      String    @unique @db.VarChar(100)

  adjustments StockAdjustment[]

  @@map("internal_use_types")
}

model StockAdjustmentItem {
  id             String    @id @default(uuid()) @db.Uuid
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdBy      String?   @db.Uuid
  updatedAt      DateTime? @db.Timestamptz(3)
  updatedBy      String?   @db.Uuid
  adjustmentId   String    @db.Uuid
  batchId        String    @db.Uuid
  productId      String    @db.Uuid
  systemQuantity Int?
  actualQuantity Int?
  quantity       Int
  unitCost       Int
  reason         String?   @db.Text
  /// Giá trả lại / đơn vị cơ bản (chỉ trả NCC).
  returnPrice        Int?
  /// Dòng phiếu nhập gốc khi trả theo phiếu nhập — trần SL = nhập − đã trả.
  goodsReceiptItemId String? @db.Uuid

  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  batch         StockBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User?           @relation("StockAdjustmentItemCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?           @relation("StockAdjustmentItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, batchId])
  @@index([batchId])
  @@index([goodsReceiptItemId])
  @@map("stock_adjustment_items")
}

model BranchProduct {
  id            String    @id @default(uuid()) @db.Uuid
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdBy     String?   @db.Uuid
  updatedAt     DateTime? @db.Timestamptz(3)
  updatedBy     String?   @db.Uuid
  branchId      String    @db.Uuid
  productId     String    @db.Uuid
  minStockLevel Int       @default(0)

  branch        Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("BranchProductCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?   @relation("BranchProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([branchId, productId])
  @@map("branch_products")
}

// ============================================================
//  BẢNG GIÁ (Thiết lập giá) — "Bảng giá chung" KHÔNG có bảng riêng: nó là `product_units.salePrice`.
//  - Xoá cứng bảng + dòng giá + phạm vi (cascade). Đơn cũ giữ `priceBookName`, `priceBookId` về null.
//  - Viết tay trong migration: unique `lower(name)` và CHECK `price_book_items.price >= 0`.
// ============================================================

/// Hàng ngoài bảng khi bán: cho thêm / thêm kèm cảnh báo / chặn.
enum PriceBookPolicy {
  ALLOW
  WARN
  BLOCK
}

model PriceBook {
  id              String          @id @default(uuid()) @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  createdBy       String?         @db.Uuid
  updatedAt       DateTime?       @db.Timestamptz(3)
  updatedBy       String?         @db.Uuid
  name            String          @unique @db.VarChar(100)
  startAt         DateTime        @db.Timestamptz(3)
  endAt           DateTime        @db.Timestamptz(3)
  status          RecordStatus    @default(ACTIVE)
  outOfBookPolicy PriceBookPolicy @default(ALLOW)
  /// Giá gốc công thức: avgCost | lastPurchaseCost | general | <uuid bảng khác>. Không FK: bảng gốc bị xoá thì service gỡ công thức.
  formulaBase     String?         @db.VarChar(50)
  /// '+' | '-'
  formulaOp       String?         @db.VarChar(1)
  formulaAmount   Decimal?         @db.Decimal(12, 2)
  /// 'vnd' | '%'
  formulaUnit     String?         @db.VarChar(3)

  branches PriceBookBranch[]
  users    PriceBookUser[]
  items    PriceBookItem[]
  orders   Order[]

  @@map("price_books")
}

/// Không có dòng nào = áp dụng mọi chi nhánh.
model PriceBookBranch {
  priceBookId String @db.Uuid
  branchId    String @db.Uuid

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([priceBookId, branchId])
  @@index([branchId])
  @@map("price_book_branches")
}

/// Không có dòng nào = áp dụng mọi người bán.
model PriceBookUser {
  priceBookId String @db.Uuid
  userId      String @db.Uuid

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([priceBookId, userId])
  @@index([userId])
  @@map("price_book_users")
}

/// Giá riêng của một (hàng, đơn vị) trong bảng. Giá nguyên đồng, >= 0 (CHECK trong migration).
model PriceBookItem {
  priceBookId   String @db.Uuid
  productUnitId String @db.Uuid
  price         Int

  priceBook   PriceBook   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)

  @@id([priceBookId, productUnitId])
  @@index([productUnitId])
  @@map("price_book_items")
}

/// Nhật ký thao tác — BẤT BIẾN, chỉ thêm. Ghi trong CÙNG transaction với thao tác nghiệp vụ.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  actorId    String      @db.Uuid
  action     AuditAction
  entityType String      @db.VarChar(50)
  entityId   String      @db.Uuid
  branchId   String?     @db.Uuid
  before     Json?       @db.JsonB
  after      Json?       @db.JsonB
  reason     String?     @db.Text
  ipAddress  String?     @db.VarChar(45)

  actor  User    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

// ============================================================
//  NHÓM BÁN HÀNG — thiết kế: docs/thiet-ke-csdl-dbml.md nhóm 4, luật: từ điển dữ liệu mục 4.4
//  - Không nhận trả hàng · thanh toán một lần đủ tiền · chưa có giảm giá · chưa có thanh toán online/hoàn tiền.
//  - Tổng tiền BigInt như phiếu nhập (K2); đơn giá Int.
//  - order_item_batches và payments không có isDeleted (lịch sử giữ/trừ kho và chứng từ tài chính).
//  - Giỏ hàng, giao hàng (carts, cart_items, shipments) thuộc phần bán online — chưa làm, thêm bằng migration riêng.
// ============================================================

enum OrderChannel {
  POS
  ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

/// Chưa có thanh toán online: VNPay/MoMo thêm sau bằng `ALTER TYPE ... ADD VALUE`.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  COD
  /// Thẻ (POS quẹt thẻ tại quầy).
  CARD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

/// Một bảng cho cả bán tại quầy và online — phân biệt bằng `channel`.
model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  isDeleted            Boolean       @default(false)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  createdBy            String?       @db.Uuid
  updatedAt            DateTime?     @db.Timestamptz(3)
  updatedBy            String?       @db.Uuid
  code                 String        @unique @db.VarChar(20)
  branchId             String        @db.Uuid
  customerId           String?       @db.Uuid
  staffId              String?       @db.Uuid
  channel              OrderChannel
  status               OrderStatus   @default(PENDING)
  subtotalAmount       BigInt        @default(0)
  shippingFee          Int           @default(0)
  /// Giảm giá cả đơn (VND, ≤ tạm tính). Tổng = tạm tính + phí ship − giảm giá.
  discountAmount       BigInt        @default(0)
  totalAmount          BigInt        @default(0)
  /// Dược sĩ ghi đè cảnh báo tương tác major: {reason, warningIds, warningSummaries, byUserId, at}.
  interactionOverride  Json?         @db.JsonB
  paymentStatus        PaymentStatus @default(UNPAID)
  prescriptionCode     String?       @db.VarChar(50)
  prescriberName       String?       @db.VarChar(150)
  prescriptionImageUrl String?       @db.Text
  note                 String?       @db.Text
  cancelReason         String?       @db.Text
  confirmedAt          DateTime?     @db.Timestamptz(3)
  completedAt          DateTime?     @db.Timestamptz(3)
  cancelledAt          DateTime?     @db.Timestamptz(3)
  /// Bảng giá đã áp lúc tạo đơn; bảng bị xoá thì về null (SetNull), tên giữ ở `priceBookName`.
  priceBookId          String?       @db.Uuid
  /// Bản chụp tên bảng giá lúc bán.
  priceBookName        String?       @db.VarChar(100)

  priceBook     PriceBook?  @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      User?       @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  staff         User?       @relation("OrderStaff", fields: [staffId], references: [id], onDelete: Restrict)
  createdByUser User?       @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?       @relation("OrderUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([createdAt])
  /// Job tự huỷ quét đơn PENDING theo kênh và thời điểm.
  @@index([status, channel, createdAt])
  @@index([priceBookId])
  @@map("orders")
}

/// Dòng đơn — tên, đơn vị, hệ số là BẢN SAO lúc bán.
model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdBy      String?   @db.Uuid
  updatedAt      DateTime? @db.Timestamptz(3)
  updatedBy      String?   @db.Uuid
  orderId        String    @db.Uuid
  productId      String    @db.Uuid
  productUnitId  String    @db.Uuid
  productName    String    @db.VarChar(250)
  unitName       String    @db.VarChar(50)
  conversionRate Int
  quantity       Int
  baseQuantity   Int
  unitPrice      Int
  totalPrice     BigInt

  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit   ProductUnit      @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  createdByUser User?            @relation("OrderItemCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?            @relation("OrderItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  batches       OrderItemBatch[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Dòng đơn lấy hàng từ lô nào. Ghi lúc giữ hàng; bất biến từ lúc trừ kho (sổ kho trỏ refItemId vào đây).
model OrderItemBatch {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  orderItemId String   @db.Uuid
  batchId     String   @db.Uuid
  quantity    Int
  unitCost    Int

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  batch     StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, batchId])
  @@index([batchId])
  @@map("order_item_batches")
}

/// Lượt thanh toán. Không xoá dòng; chỉ cập nhật trạng thái (vd COD: PENDING lúc đặt → SUCCESS khi giao xong).
model Payment {
  id              String            @id @default(uuid()) @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  createdBy       String?           @db.Uuid
  updatedAt       DateTime?         @db.Timestamptz(3)
  orderId         String            @db.Uuid
  method          PaymentMethod
  amount          BigInt
  status          TransactionStatus @default(PENDING)
  /// Mã tham chiếu chuyển khoản ngân hàng.
  transactionCode String?           @db.VarChar(100)
  paidAt          DateTime?         @db.Timestamptz(3)
  note            String?           @db.Text

  order         Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([method, transactionCode])
  @@index([orderId])
  @@map("payments")
}
