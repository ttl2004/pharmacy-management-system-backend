{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.hbs", "outDir": "./dist" },
      { "include": "**/*handlebars", "outDir": "./dist" }
    ],
    "watchAssets": true
  }
}
